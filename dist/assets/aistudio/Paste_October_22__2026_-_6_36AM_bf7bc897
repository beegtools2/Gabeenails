            document.getElementById('flipbook-title').innerText = type === 'terms' ? 'Términos y Condiciones' : 'Beneficios en Gabee Studio';
            renderFlipbookPage();
            document.getElementById('flipbook-modal').classList.remove('hidden');
        }
        function closeFlipbook() { document.getElementById('flipbook-modal').classList.add('hidden'); }
        function renderFlipbookPage() {
            const data = flipbookData[currentType];
            const content = data[currentPage - 1];
            document.getElementById('flipbook-content').innerHTML = `
                <div>
                    <h4 class="cinzel text-lg font-bold text-brandBrown mb-4">${content.title}</h4>
                    <p class="text-xs text-brandBrown/80 whitespace-pre-line leading-relaxed">${content.text}</p>
                </div>
                <div class="text-[10px] text-brandBrown/40 text-center uppercase tracking-widest mt-4">Gabee Studio • Libro Oficial</div>
            `;
            document.getElementById('page-indicator').innerText = `Página ${currentPage} de ${data.length}`;
        }
        function nextPage() {
            if (currentPage < flipbookData[currentType].length) { currentPage++; renderFlipbookPage(); }
        }
        function prevPage() {
            if (currentPage > 1) { currentPage--; renderFlipbookPage(); }
