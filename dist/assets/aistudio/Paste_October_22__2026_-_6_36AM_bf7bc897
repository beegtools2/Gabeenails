<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gabee Studio</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ivory: '#FBF9F5',
                        brandBrown: '#3E2723',
                        brandGold: '#D4AF37',
                        brandGoldLight: '#F3E5AB',
                        softMaroon: '#4A2C2A'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Cinzel Decorative y Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #FBF9F5;
            color: #3E2723;
        }
        .cinzel {
            font-family: 'Cinzel Decorative', serif;
        }
        /* Patrón de abejas dorado translúcido (restringido estrictamente a Header, Footer y barras modales) */
        .bee-pattern-bg {
            background-color: rgba(212, 175, 55, 0.08);
            background-image: radial-gradient(rgba(212, 175, 55, 0.15) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        /* Efecto Glassmorphism y Hover de lujo (brillo dorado tenue) */
        .glass-panel {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.2);
            transition: all 0.3s ease;
        }
        .glass-panel:hover {
            border-color: #D4AF37;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
        }
        /* Estilos del Flipbook (Libro Interactivo) */
        .book-container {
            width: 100%;
            max-width: 800px;
            height: 480px;
            position: relative;
            background: #FFFDF9;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body class="bg-ivory text-brandBrown min-h-screen flex flex-col justify-between">

    <!-- HEADER / NAVEGACIÓN (CON PATRÓN DE ABEJAS) -->
    <header class="sticky top-0 z-40 bee-pattern-bg border-b border-brandGold/30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- LOGO -->
            <div class="flex items-center space-x-3 bg-white/80 px-4 py-2 rounded-xl border border-brandGold/30">
                <span class="cinzel text-xl font-bold tracking-wider text-brandBrown">Gabee</span>
                <div>
                    <h1 class="cinzel text-lg font-bold tracking-widest text-brandBrown leading-none">GABEE STUDIO</h1>
                    <p class="text-[9px] uppercase tracking-wider text-brandGold font-semibold">DONDE EL AMOR Y EL ARTE SE ENCUENTRAN</p>
                </div>
            </div>

            <!-- NAVEGACIÓN PRINCIPAL -->
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
                <a href="#inicio" class="hover:text-brandGold transition">INICIO</a>
                <a href="#servicios" class="hover:text-brandGold transition">SERVICIOS</a>
                <a href="#presson" class="hover:text-brandGold transition">PRESS ON</a>
                <a href="#cursos" class="hover:text-brandGold transition">CURSOS</a>
            </nav>

            <!-- BOTÓN ADMIN -->
            <div>
                <button onclick="toggleAdminPanel()" class="px-4 py-2 text-xs font-semibold tracking-wider border border-brandBrown/30 rounded-lg hover:bg-brandBrown hover:text-white transition flex items-center gap-2">
                    <i class="fa-solid fa-lock"></i> ADMIN
                </button>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-grow">
        <!-- HERO / SECCIÓN INICIAL -->
        <section id="inicio" class="py-16 px-4 text-center max-w-4xl mx-auto">
            <div class="mb-6 inline-block p-3 rounded-full bg-brandGold/10 border border-brandGold/30">
                <i class="fa-solid fa-gem text-brandGold text-2xl"></i>
            </div>
            <h2 class="cinzel text-4xl sm:text-5xl font-bold text-brandBrown mb-4">Gabee</h2>
            <p class="cinzel text-2xl sm:text-3xl text-brandBrown mb-8 font-light">DONDE EL AMOR <br>Y EL ARTE SE ENCUENTRAN</p>
            <p class="text-xs text-brandBrown/70 uppercase tracking-widest mb-10">lima, perú • @gabeenailsart • pedidos & servicios</p>

            <!-- BOTONES INTERACTIVOS (TÉRMINOS Y BENEFICIOS - LIBROS REALISTAS) -->
            <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-lg mx-auto">
                <button onclick="openFlipbook('terms')" class="flex-1 py-3 px-6 bg-white border border-brandGold/40 rounded-xl shadow-sm hover:shadow-md hover:border-brandGold transition text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2">
                    <i class="fa-solid fa-book-open text-brandGold"></i> Términos y Condiciones
                </button>
                <button onclick="openFlipbook('benefits')" class="flex-1 py-3 px-6 bg-white border border-brandGold/40 rounded-xl shadow-sm hover:shadow-md hover:border-brandGold transition text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2">
                    <i class="fa-solid fa-star text-brandGold"></i> Beneficios en Gabee Studio
                </button>
            </div>
        </section>

        <!-- SECCIÓN NUESTROS SERVICIOS -->
        <section id="servicios" class="py-12 px-4 max-w-7xl mx-auto">
            <div class="flex justify-between items-center mb-8 border-b border-brandBrown/10 pb-4">
                <div>
                    <h3 class="cinzel text-2xl font-bold">Nuestros Servicios</h3>
                    <p class="text-xs text-brandBrown/70 uppercase tracking-wider">Sistema profesional de aplicación</p>
                </div>
            </div>

            <!-- GRID DE SERVICIOS -->
            <div id="services-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Softgel -->
                <div class="glass-panel p-6 rounded-2xl shadow-sm flex flex-col justify-between">
                    <div>
                        <img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&q=80&w=600" alt="Softgel" class="w-full h-48 object-cover rounded-xl mb-4 service-img">
                        <h4 class="cinzel text-xl font-bold mb-2 service-title">SOFTGEL</h4>
                        <p class="text-xs text-brandBrown/80 mb-4 service-desc">Tips de gel flexible prensado y adherido con base coat curado en cabina UV. Máxima ligereza, flexibilidad y acabado ultranatural sin olor a monómero.</p>
                    </div>
                    <div>
                        <div class="text-xs font-semibold text-brandGold mb-4 service-price">DESDE S/. 60</div>
                        <button onclick="openBooking('Softgel')" class="w-full py-2 bg-brandBrown text-white rounded-xl text-xs font-semibold uppercase tracking-wider hover:bg-brandGold transition">Personalizar Set</button>
                    </div>
                </div>
                <!-- Polygel -->
                <div class="glass-panel p-6 rounded-2xl shadow-sm flex flex-col justify-between">
                    <div>
                        <img src="https://images.unsplash.com/photo-1519014816548-bf5fe059798b?auto=format&fit=crop&q=80&w=600" alt="Polygel" class="w-full h-48 object-cover rounded-xl mb-4 service-img">
                        <h4 class="cinzel text-xl font-bold mb-2 service-title">POLYMEL / POLYGEL</h4>
                        <p class="text-xs text-brandBrown/80 mb-4 service-desc">Fórmula híbrida que une la durabilidad del acrílico con la flexibilidad del gel. Esculpido perfecto con dual forms o molde sin dañar la lámina ungueal.</p>
                    </div>
                    <div>
                        <div class="text-xs font-semibold text-brandGold mb-4 service-price">DESDE S/. 60</div>
                        <button onclick="openBooking('Polygel')" class="w-full py-2 bg-brandBrown text-white rounded-xl text-xs font-semibold uppercase tracking-wider hover:bg-brandGold transition">Personalizar Set</button>
                    </div>
                </div>
                <!-- Uñas Acrílicas -->
                <div class="glass-panel p-6 rounded-2xl shadow-sm flex flex-col justify-between">
                    <div>
                        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&q=80&w=600" alt="Acrílicas" class="w-full h-48 object-cover rounded-xl mb-4 service-img">
                        <h4 class="cinzel text-xl font-bold mb-2 service-title">UÑAS ACRÍLICAS</h4>
                        <p class="text-xs text-brandBrown/80 mb-4 service-desc">Sistema tradicional de alta resistencia y durabilidad excepcional. Ideal para extensiones largas, estructuras complejas y diseños personalizados sólidos.</p>
                    </div>
                    <div>
                        <div class="text-xs font-semibold text-brandGold mb-4 service-price">DESDE S/. 80</div>
                        <button onclick="openBooking('Uñas Acrílicas')" class="w-full py-2 bg-brandBrown text-white rounded-xl text-xs font-semibold uppercase tracking-wider hover:bg-brandGold transition">Personalizar Set</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN PRESS ON NAILS -->
        <section id="presson" class="py-12 px-4 max-w-7xl mx-auto">
            <div class="text-center mb-8">
                <div class="text-xs uppercase tracking-widest text-brandGold mb-2">✦ Press On Nails ✦</div>
                <h3 class="cinzel text-3xl font-bold mb-2">Sets Prediseñados Reutilizables</h3>
                <p class="text-xs text-brandBrown/70 max-w-md mx-auto mb-6">Uñas artesanales reutilizables creadas a mano a tu medida exacta. Listas para colocar en casa en solo 10 minutos.</p>
                
                <!-- DOS BOTONES PRINCIPALES SEPARADOS -->
                <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-md mx-auto">
                    <button onclick="openCatalogModal()" class="flex-1 py-3 px-6 bg-brandBrown text-white rounded-xl text-xs font-semibold uppercase tracking-wider hover:bg-brandGold transition shadow-sm">
                        <i class="fa-solid fa-box-archive mr-2"></i> Catálogo Press On
                    </button>
                    <button onclick="openCustomOrderModal()" class="flex-1 py-3 px-6 bg-white border border-brandGold/50 text-brandBrown rounded-xl text-xs font-semibold uppercase tracking-wider hover:border-brandGold transition shadow-sm">
                        <i class="fa-solid fa-wand-magic-sparkles mr-2 text-brandGold"></i> Pedido personalizado
                    </button>
                </div>
            </div>

            <div id="presson-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto mt-8">
                <div class="glass-panel p-6 rounded-2xl shadow-sm flex flex-col justify-between cursor-pointer" onclick="openCatalogModal()">
                    <div>
                        <img src="https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&q=80&w=600" alt="Press On 1" class="w-full h-56 object-cover rounded-xl mb-4 presson-img">
                        <h4 class="cinzel text-lg font-bold mb-1 presson-title">SET I · VELVET CAT-EYE & CROMO</h4>
                        <p class="text-xs text-brandBrown/80 mb-4 presson-desc">Diseños magnéticos y acabados metálicos en tendencia.</p>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-semibold text-brandGold presson-price">S/. 80.00</span>
                        <span class="text-xs font-semibold text-brandBrown underline">Ver detalles y comprar</span>
                    </div>
                </div>
                <div class="glass-panel p-6 rounded-2xl shadow-sm flex flex-col justify-between cursor-pointer" onclick="openCatalogModal()">
                    <div>
                        <img src="https://images.unsplash.com/photo-1632345031435-8727f6c97d34?auto=format&fit=crop&q=80&w=600" alt="Press On 2" class="w-full h-56 object-cover rounded-xl mb-4 presson-img">
                        <h4 class="cinzel text-lg font-bold mb-1 presson-title">SET II · 3D GEL SCULPTED</h4>
                        <p class="text-xs text-brandBrown/80 mb-4 presson-desc">Figuras en relieve y detalles artísticos hechos a mano.</p>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-semibold text-brandGold presson-price">S/. 60.00</span>
                        <span class="text-xs font-semibold text-brandBrown underline">Ver detalles y comprar</span>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- FOOTER / PIE DE PÁGINA (CON PATRÓN DE ABEJAS) -->
    <footer class="bee-pattern-bg border-t border-brandGold/30 mt-20 pt-12 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
            <!-- LOGO & INFO -->
            <div class="space-y-3">
                <div class="flex items-center space-x-3 bg-white/80 p-3 rounded-xl border border-brandGold/30 inline-flex">
                    <span class="cinzel text-lg font-bold tracking-wider text-brandBrown">Gabee</span>
                    <div>
                        <h2 class="cinzel text-sm font-bold tracking-widest text-brandBrown leading-none">GABEE STUDIO</h2>
                        <p class="text-[8px] uppercase tracking-wider text-brandGold font-semibold">DONDE EL AMOR Y EL ARTE SE ENCUENTRAN</p>
                    </div>
                </div>
                <p class="text-xs text-brandBrown/80">Studio Profesional en Lima, Perú.</p>
                <p class="text-[10px] text-brandBrown/60 uppercase">BEETOOLS E.I.R.L. • RUC: 20614757257</p>
            </div>

            <!-- REDES SOCIALES -->
            <div class="text-center">
                <h4 class="cinzel text-xs font-bold tracking-widest uppercase mb-4 text-brandBrown">Síguenos en nuestras redes sociales</h4>
                <div class="flex justify-center space-x-4 text-brandBrown">
                    <a href="https://www.facebook.com/gabeenailsart/about/" target="_blank" class="w-9 h-9 rounded-full bg-white border border-brandGold/30 flex items-center justify-center hover:bg-brandGold hover:text-white transition"><i class="fa-brands fa-facebook-f text-xs"></i></a>
                    <a href="https://www.instagram.com/gabeenailsart/" target="_blank" class="w-9 h-9 rounded-full bg-white border border-brandGold/30 flex items-center justify-center hover:bg-brandGold hover:text-white transition"><i class="fa-brands fa-instagram text-xs"></i></a>
                    <a href="https://www.youtube.com/@GabeenailsArt" target="_blank" class="w-9 h-9 rounded-full bg-white border border-brandGold/30 flex items-center justify-center hover:bg-brandGold hover:text-white transition"><i class="fa-brands fa-youtube text-xs"></i></a>
                    <a href="https://www.threads.net/@gabeenailsart" target="_blank" class="w-9 h-9 rounded-full bg-white border border-brandGold/30 flex items-center justify-center hover:bg-brandGold hover:text-white transition"><i class="fa-solid fa-at text-xs"></i></a>
                </div>
            </div>

            <!-- LIBRO DE RECLAMACIONES -->
            <div class="flex justify-md-end justify-center">
                <div class="glass-panel p-4 rounded-xl flex items-center space-x-3 border border-brandGold/30 max-w-xs">
                    <i class="fa-solid fa-book text-brandGold text-2xl"></i>
                    <div>
                        <h5 class="cinzel text-[10px] font-bold uppercase">Libro de Reclamaciones</h5>
                        <p class="text-[9px] text-brandBrown/70">Conforme a Ley N° 29571 - Indecopi</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pt-4 border-t border-brandBrown/10 text-center text-[10px] text-brandBrown/50">
            BEETOOLS EIRL • DERECHOS RESERVADOS © 2026
        </div>
    </footer>

    <!-- VENTANA MODAL DE CATÁLOGO PRESS ON (CON VISOR DE FOTOS, TALLAS Y KITS) -->
    <div id="catalog-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-ivory w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden border border-brandGold/30 flex flex-col max-h-[95vh]">
            <!-- HEADER CON ABEJITAS -->
            <div class="bee-pattern-bg px-6 py-4 border-b border-brandGold/30 flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <span class="cinzel text-xs font-bold text-brandBrown">Gabee</span>
                    <span class="text-xs uppercase tracking-wider text-brandBrown">CATÁLOGO PRESS ON · GABEE STUDIO</span>
                </div>
                <button onclick="closeCatalogModal()" class="w-8 h-8 rounded-full bg-white/80 flex items-center justify-center text-brandBrown hover:bg-brandGold hover:text-white transition"><i class="fa-solid fa-xmark text-sm"></i></button>
            </div>

            <!-- CONTENIDO DE LA MODAL (FONDO MARRONCITO CLARO TRANSLÚCIDO) -->
            <div class="p-6 overflow-y-auto flex-grow space-y-6 bg-[#F5EFEB]/80">
                <!-- VISOR DE FOTOS DINÁMICO CON FLECHITAS -->
                <div class="relative bg-white p-2 rounded-xl border border-brandGold/30 shadow-sm">
                    <img id="catalog-active-img" src="https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&q=80&w=600" alt="Set Preview" class="w-full h-64 object-cover rounded-lg">
                    <button onclick="prevCatalogPhoto()" class="absolute left-4 top-1/2 -translate-y-1/2 w-8 h-8 bg-white/90 rounded-full shadow flex items-center justify-center text-brandBrown hover:bg-brandGold hover:text-white transition"><i class="fa-solid fa-chevron-left text-xs"></i></button>
                    <button onclick="nextCatalogPhoto()" class="absolute right-4 top-1/2 -translate-y-1/2 w-8 h-8 bg-white/90 rounded-full shadow flex items-center justify-center text-brandBrown hover:bg-brandGold hover:text-white transition"><i class="fa-solid fa-chevron-right text-xs"></i></button>
                </div>

                <!-- DETALLES DEL DISEÑO -->
                <div class="text-center space-y-1">
                    <h4 id="catalog-item-name" class="cinzel text-xl font-bold">SET I · VELVET CAT-EYE & CROMO</h4>
                    <p id="catalog-item-price" class="text-sm font-semibold text-brandGold">S/. 80.00</p>
                </div>

                <!-- TIPO DE PUNTA Y TALLAS (SOLO LETRAS: XS, S, M, L) -->
                <div class="space-y-4 bg-white/90 p-4 rounded-xl border border-brandGold/20">
                    <div>
                        <label class="text-xs font-semibold uppercase tracking-wider text-brandBrown block mb-2">1. Selecciona el Tipo de Punta</label>
                        <select id="tip-type-select" onchange="updateSizeChart()" class="w-full p-2.5 text-xs bg-ivory border border-brandBrown/20 rounded-xl focus:border-brandGold">
                            <option value="almendra">Punta Almendra</option>
                            <option value="stiletto">Punta Stiletto</option>
                            <option value="coffin">Punta Coffin</option>
                            <option value="square">Punta Square (Cuadrada)</option>
                        </select>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="text-xs font-semibold uppercase tracking-wider text-brandBrown">2. Selecciona tu Talla</label>
                            <button onclick="openSizeChartModal()" class="text-[10px] text-brandGold underline font-semibold">Ver tabla de milímetros</button>
                        </div>
                        <div class="grid grid-cols-4 gap-2">
                            <button onclick="selectSize('XS')" id="btn-size-XS" class="py-2.5 rounded-xl border border-brandBrown/20 text-xs font-bold transition hover:border-brandGold">XS</button>
                            <button onclick="selectSize('S')" id="btn-size-S" class="py-2.5 rounded-xl border border-brandBrown/20 text-xs font-bold transition hover:border-brandGold">S</button>
                            <button onclick="selectSize('M')" id="btn-size-M" class="py-2.5 rounded-xl border border-brandBrown/20 text-xs font-bold transition hover:border-brandGold">M</button>
                            <button onclick="selectSize('L')" id="btn-size-L" class="py-2.5 rounded-xl border border-brandBrown/20 text-xs font-bold transition hover:border-brandGold">L</button>
                        </div>
                    </div>
                </div>

                <!-- SELECCIÓN DE KITS DE APLICACIÓN CON DESCUENTO AUTOMÁTICO -->
                <div class="space-y-3 bg-white/90 p-4 rounded-xl border border-brandGold/20">
                    <label class="text-xs font-semibold uppercase tracking-wider text-brandBrown block">3. Kit de Aplicación Incluido / Opcional</label>
                    <div id="kit-auto-banner" class="p-3 bg-brandGold/10 rounded-xl border border-brandGold/40 text-[11px] text-brandBrown">
                        🎉 <span class="font-bold">¡Beneficio aplicado!</span> Por tu compra de S/. 80, te llevas el <span class="font-bold text-brandGold">Kit Premium (Valorizado en S/. 25) ¡GRATIS!</span>
                    </div>

                    <div class="space-y-2">
                        <label class="flex items-center justify-between p-3 rounded-xl border border-brandBrown/20 cursor-pointer hover:border-brandGold transition">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="app-kit" value="Elemental" class="text-brandGold">
                                <span class="text-xs font-bold">Kit Elemental</span>
                            </div>
                            <span class="text-xs font-semibold text-brandGold">S/. 15</span>
                        </label>
                        <label class="flex items-center justify-between p-3 rounded-xl border border-brandBrown/20 cursor-pointer hover:border-brandGold transition">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="app-kit" value="Standard" class="text-brandGold">
                                <span class="text-xs font-bold">Kit Standard</span>
                            </div>
                            <span class="text-xs font-semibold text-brandGold">S/. 20</span>
                        </label>
                        <label class="flex items-center justify-between p-3 rounded-xl border border-brandBrown/20 cursor-pointer hover:border-brandGold transition">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="app-kit" value="Premium" checked class="text-brandGold">
                                <span class="text-xs font-bold">Kit Premium (Incluido Gratis)</span>
                            </div>
                            <span class="text-xs font-semibold text-brandGold">S/. 25</span>
                        </label>
                    </div>
                    <p class="text-[10px] text-brandBrown/70 italic">* Todos los kits incluyen regalito sorpresa y stickers cute. Puedes ver el contenido detallado en nuestros términos.</p>
                </div>

                <!-- DATOS DE ENVÍO Y PAGO AL 100% -->
                <div class="space-y-3 bg-white/90 p-4 rounded-xl border border-brandGold/20">
                    <label class="text-xs font-semibold uppercase tracking-wider text-brandBrown block">4. Datos de Envío y Pago (100% Adelantado)</label>
                    <div class="grid grid-cols-2 gap-3">
                        <input type="text" placeholder="Nombres" class="p-2.5 text-xs bg-ivory border rounded-xl">
                        <input type="text" placeholder="Apellidos" class="p-2.5 text-xs bg-ivory border rounded-xl">
                    </div>
                    <input type="text" placeholder="Celular / WhatsApp" class="w-full p-2.5 text-xs bg-ivory border rounded-xl">
                    <select class="w-full p-2.5 text-xs bg-ivory border rounded-xl">
                        <option>Recojo en tienda (Gratis)</option>
                        <option>Envío a domicilio (Se coordina distrito)</option>
                    </select>
                    <input type="text" placeholder="Dirección exacta para envío" class="w-full p-2.5 text-xs bg-ivory border rounded-xl">
                </div>
            </div>

            <!-- FOOTER CON ABEJITAS Y BOTÓN DE PAGO -->
